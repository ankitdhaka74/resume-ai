generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ResumeAnalysis {
  id        String   @id @default(cuid())
  fileName  String
  atsScore  Int
  jobMatch  Int?
  summary   String
  createdAt DateTime @default(now())
}